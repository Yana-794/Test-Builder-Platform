    "securityDefinitions": {
        "CookieAuth": {
            "description": "Вставьте сюда строку вида: tbp_session=\u003cтокен из cookie\u003e",
            "type": "apiKey",
            "name": "Cookie",
            "in": "header"
        },
        "CsrfToken": {
            "description": "CSRF-токен (из ответа POST /auth/login или GET /auth/me)",
            "type": "apiKey",
            "name": "X-CSRF-Token",
            "in": "header"
        }
